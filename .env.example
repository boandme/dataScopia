KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
KAGGLE_API_TOKEN=your_kaggle_api_token
# Optional: only needed for gated Hugging Face datasets or to raise the (already generous) public
# rate limit - public dataset search and analysis work with no token at all.
HF_TOKEN=
APP_TITLE=DataScopia
APP_ENV=development
# How many megabytes of a dataset file to stream for sample-based analysis (default analysis
# path never downloads the full dataset). Increase for higher-fidelity sampling on large files.
ANALYSIS_SAMPLE_MB=5
# Largest file "Use your own file" will accept, in megabytes. Requests over this get a clean 413
# instead of risking an out-of-memory crash on a small instance.
DATASCOPIA_MAX_UPLOAD_MB=150
# Only needed if the frontend is hosted on a different origin than this API - e.g. a GitHub Pages
# build of apps/web (see tools/build_static_site.py). Set this to that frontend's exact origin
# (scheme + host, no trailing slash, e.g. https://you.github.io) so sign-in/save-to-account can
# work cross-site. Leave unset for a normal same-origin deployment - nothing about CORS, cookies
# or CSRF changes when this is unset.
DATASCOPIA_TRUSTED_ORIGIN=

# --- Firebase (see docs/FIREBASE_SETUP.md) ---
# Accounts use Firebase Authentication by default; set to "local" for built-in email + password accounts.
DATASCOPIA_AUTH=firebase
# Your Realtime Database URL (Firebase console -> Build -> Realtime Database -> top of the Data tab).
FIREBASE_DATABASE_URL=
# Server credentials for the Realtime Database + Cloud Storage. Paste the service-account key JSON (or its
# base64) or point at the file. Keep it secret and out of git. Without both of these, data is stored locally
# in SQLite + the data/ folder.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=
